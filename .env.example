# LearnQuest Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# ==============================================================================
# SERVER & API CONFIGURATION
# ==============================================================================
PORT=4000
NODE_ENV=development
JWT_SECRET=r4YS+gTDIS5kdA9gDp2g7A1ziI1GXhkMMx4r9EFF5G0KIkMEm+tAwJPutk3EFYVi
JWT_EXPIRY=7d
CORS_ORIGIN=*

# ==============================================================================
# DATABASE (PostgreSQL & Prisma)
# ==============================================================================
# Connects to PostgreSQL container or local installation
DATABASE_URL=postgresql://neondb_owner:npg_KwViMu5QCHP3@ep-soft-poetry-b5hhi6ee-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct connection used by Prisma migrations/db push (not the pooled URL).
# For local PostgreSQL this can be the same as DATABASE_URL. Neon writes this
# value as DATABASE_URL_UNPOOLED in .env.local during `neon deploy`.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:npg_KwViMu5QCHP3@ep-soft-poetry-b5hhi6ee.c-7.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Optional SQLite fallback URL for quick offline testing without Docker:
# DATABASE_URL=file:./dev.db

# ==============================================================================
# AI PROVIDER (Google Gemini - backend only)
# ==============================================================================
# Create an API key at https://aistudio.google.com/apikey
# NEVER expose this key through VITE_* or EXPO_PUBLIC_* variables.
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyCVD_wir3DumAdGyHULweszCWTSnipLYAI
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_CACHE_TTL_MS=600000
AI_CACHE_MAX_ENTRIES=200

# Optional: force the verified offline curriculum without calling Gemini.
# AI_PROVIDER=curated

# ==============================================================================
# MST BLOCKCHAIN CONFIGURATION (MST Testnet)
# Verified on chainlist.org & mstblockchain.com
# ==============================================================================
MST_NETWORK_NAME=MST Testnet
MST_CHAIN_ID=91562037
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_EXPLORER_URL=https://testnet.mstscan.com
MST_CURRENCY_SYMBOL=tMSTC

# MST Mainnet Reference:
# MST_MAINNET_CHAIN_ID=4646
# MST_MAINNET_RPC_URL=https://mariorpc.mstblockchain.com
# MST_MAINNET_EXPLORER_URL=https://mstscan.com

# Backend signer private key for EIP-712 reward vouchers (Operator wallet)
# DO NOT COMMIT ACTUAL PRIVATE KEYS TO SOURCE CONTROL!
# This key must derive to the signerAddress stored in MST_REWARDS_ADDRESS.
# The deployed contract 0xBA1969... accepts signerAddress 0x0E370085799a51a1e437D34F5385032B2fBCeAA9
# until the owner calls setSignerAddress(newOperatorAddress).
# Generate a dedicated key with:
#   node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
REWARD_SIGNER_PRIVATE_KEY=

# Deployed Smart Contract Addresses on MST Testnet
MST_TOKEN_ADDRESS=0x51825657e00622B538B920551aE845F3f95faC95
MST_REWARDS_ADDRESS=0xBA1969Ff27F0e2cBD443B817f9d4c7b7d8449314
MST_STORE_ADDRESS=0xfF169521b09f77e7867B857511E79695C47348db
MST_ACHIEVEMENTS_ADDRESS=0x14d2f7Ca4AD3725E384efD83DC0C598716b05B4C

# Treasury wallet receiving token payments from store
MST_TREASURY_ADDRESS=0x0E370085799a51a1e437D34F5385032B2fBCeAA9

# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT VARIABLES
# ==============================================================================
VITE_API_BASE_URL=http://localhost:4000
VITE_MST_CHAIN_ID=91562037
VITE_MST_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_MST_EXPLORER_URL=https://testnet.mstscan.com

# Mobile: use your computer's LAN IP for a physical Android device.
# Android emulator can use http://10.0.2.2:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_MST_CHAIN_ID=91562037
EXPO_PUBLIC_MST_RPC_URL=https://testnetrpc.mstblockchain.com
