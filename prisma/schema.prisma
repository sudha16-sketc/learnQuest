// Prisma Schema for LearnQuest

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  ABANDONED
}

enum EntitlementStatus {
  PENDING
  VOUCHER_ISSUED
  CLAIMED
  EXPIRED
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum TransactionStatus {
  SUBMITTED
  CONFIRMED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallets              Wallet[]
  sessions             LearningSession[]
  xpEntries            XPEntry[]
  skillProgress        SkillProgress[]
  rewardEntitlements   RewardEntitlement[]
  purchases            Purchase[]
  accessories          AccessoryUnlock[]
  achievements         Achievement[]
  idempotencyRecords   IdempotencyRecord[]

  @@index([email])
  @@index([username])
}

model Wallet {
  id             String   @id @default(uuid())
  userId         String
  address        String   @unique
  chainId        Int
  isPrimary      Boolean  @default(true)
  linkedAt       DateTime @default(now())
  signatureProof String?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([address])
}

model Topic {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  description      String
  category         String   @default("Blockchain")
  difficultyLevels String[] @default(["beginner", "intermediate", "advanced"])
  icon             String   @default("cube")
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions         LearningSession[]
  skillProgress    SkillProgress[]

  @@index([slug])
}

model LearningSession {
  id              String        @id @default(uuid())
  userId          String
  topicId         String
  difficulty      String        @default("beginner")
  currentPlatform Int           @default(0)
  masteryScore    Float         @default(0.0)
  status          SessionStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  completedAt     DateTime?

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic           Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts        QuestionAttempt[]

  @@index([userId])
  @@index([topicId])
  @@index([status])
}

model QuestionAttempt {
  id           String          @id @default(uuid())
  sessionId    String
  questionId   String
  concept      String
  chosenOption Int
  isCorrect    Boolean
  hintsUsed    Int             @default(0)
  timeSpentMs  Int             @default(0)
  createdAt    DateTime        @default(now())

  session      LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
}

model SkillProgress {
  id              String   @id @default(uuid())
  userId          String
  topicId         String
  concept         String
  masteryLevel    Float    @default(0.0)
  totalAttempts   Int      @default(0)
  correctAttempts Int      @default(0)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, concept])
  @@index([userId])
}

model XPEntry {
  id             String   @id @default(uuid())
  userId         String
  amount         Int
  reason         String
  referenceId    String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idempotencyKey])
}

model RewardEntitlement {
  id               String            @id @default(uuid())
  userId           String
  amountTokens     Decimal           @default(0.0)
  reason           String
  voucherNonce     BigInt?           @unique
  voucherSignature String?
  status           EntitlementStatus @default(PENDING)
  expiresAt        DateTime?
  claimedAt        DateTime?
  createdAt        DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardClaim      RewardClaim?

  @@index([userId])
  @@index([status])
}

model RewardClaim {
  id              String            @id @default(uuid())
  entitlementId   String            @unique
  userAddress     String
  transactionHash String            @unique
  blockNumber     BigInt?
  claimedAt       DateTime          @default(now())

  entitlement     RewardEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([userAddress])
  @@index([transactionHash])
}

model StoreItem {
  id          String     @id @default(uuid())
  sku         String     @unique
  name        String
  description String
  category    String     // "hint", "accessory", "content"
  priceTokens Decimal
  isAvailable Boolean    @default(true)
  metadata    Json?
  createdAt   DateTime   @default(now())

  purchases   Purchase[]
  accessories AccessoryUnlock[]

  @@index([sku])
  @@index([category])
}

model Purchase {
  id              String         @id @default(uuid())
  userId          String
  itemId          String
  transactionHash String         @unique
  blockNumber     BigInt?
  status          PurchaseStatus @default(PENDING)
  purchasedAt     DateTime       @default(now())

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item            StoreItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionHash])
}

model AccessoryUnlock {
  id         String    @id @default(uuid())
  userId     String
  itemId     String
  isEquipped Boolean   @default(false)
  unlockedAt DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

model Achievement {
  id                 String   @id @default(uuid())
  userId             String
  achievementType    String
  title              String
  description        String
  transactionHash    String?  @unique
  blockNumber        BigInt?
  tokenCertificateId BigInt?
  unlockedAt         DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BlockchainTransaction {
  id             String            @id @default(uuid())
  hash           String            @unique
  type           String            // "CLAIM", "PURCHASE", "ACHIEVEMENT"
  fromAddress    String
  toAddress      String
  status         TransactionStatus @default(SUBMITTED)
  blockNumber    BigInt?
  confirmations  Int               @default(0)
  createdAt      DateTime          @default(now())

  @@index([hash])
  @@index([fromAddress])
  @@index([status])
}

model IdempotencyRecord {
  id              String   @id @default(uuid())
  key             String   @unique
  userId          String
  actionType      String
  responsePayload Json
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
}
