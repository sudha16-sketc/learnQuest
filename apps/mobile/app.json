{
  "expo": {
    "name": "LearnQuest",
    "slug": "learnquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "learnquest",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sudha2216.learnquestmonorepo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0d14"
      },
      "package": "com.sudha2216.learnquestmonorepo",
      "permissions": [
        "INTERNET"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bf8fca7f-afe8-4952-be5f-a9e6386c5009"
      }
    },
    "owner": "sudha2216",
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0d14",
          "enableFullScreenImage_legacy": true
        }
      ]
    ]
  }
}
