{
  "name": "learnquest-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LearnQuest - AI-Powered 3D Learning Game + MST Blockchain + Utility Token",
  "workspaces": [
    "packages/*",
    "apps/*",
    "contracts"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@learnquest/api run dev",
    "dev:web": "npm --workspace=@learnquest/web run dev",
    "build": "npm run build:packages && npm run build:web",
    "build:packages": "npm --workspace=@learnquest/shared run build && npm --workspace=@learnquest/game-core run build",
    "build:web": "npm --workspace=@learnquest/web run build",
    "test:contracts": "npm --workspace=@learnquest/contracts run test",
    "test:api": "npm --workspace=@learnquest/api run test",
    "test": "npm run test:contracts && npm run test:api",
    "db:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js generate",
    "db:push": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js db push",
    "db:seed": "node apps/api/src/scripts/seed.js"
  },
  "keywords": [
    "learnquest",
    "threejs",
    "web3",
    "blockchain",
    "mst-chain",
    "gemini",
    "google-genai",
    "game",
    "education"
  ],
  "author": "LearnQuest Team",
  "license": "MIT",
  "devDependencies": {
    "prisma": "^5.14.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.65.1",
    "@rollup/rollup-win32-x64-msvc": "^4.65.1"
  },
  "dependencies": {
    "@mstblockchain/mst-sdk": "^1.0.0",
    "@mstblockchain/mst-vibe-kit": "^0.1.1",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  }
}
